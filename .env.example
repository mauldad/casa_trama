SITE_URL=https://casatrama.cl
PUBLIC_WP_URL=https://blog.casatrama.cl
# Futuro: WPGraphQL (no instalado aún en blog.casatrama.cl)
# WP_GRAPHQL_URL=https://blog.casatrama.cl/graphql
WOO_STORE_API_URL=https://blog.casatrama.cl/wp-json/wc/store/v1
# Solo para scripts de seed / admin y sync de pedidos pagados (nunca en el frontend):
# WC_CONSUMER_KEY=ck_...
# WC_CONSUMER_SECRET=cs_...
# WP_URL=https://blog.casatrama.cl
# Auth Mi trama (mismo CT_AUTH_SECRET en wp-config.php del plugin casa-trama-auth):
# CT_AUTH_SECRET=
# CT_SESSION_SECRET=
# Cloudflare Turnstile (login / crear cuenta):
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEjVI0NVzzaL-vJz
# TURNSTILE_SECRET=
# Prod Netlify: casatrama.cl — Local: localhost,127.0.0.1,casatrama.cl
# TURNSTILE_HOSTNAMES=
PUBLIC_GTM_ID=GTM-XXXXXXX
RESEND_API_KEY=
# Remitente verificado en Resend (producción). Para pruebas: Casa Trama <onboarding@resend.dev>
RESEND_FROM_EMAIL=Casa Trama <onboarding@resend.dev>
CONTACT_TO_EMAIL=hola@casatrama.cl
# Bandeja de pedidos (si no se define, usa CONTACT_TO_EMAIL)
ORDERS_TO_EMAIL=hola@casatrama.cl
# Loops.so — Cartas Casa Trama (newsletter)
LOOPS_API_KEY=
# Opcional: ID de lista en Loops (si creas una mailing list)
# LOOPS_MAILING_LIST_ID=
DATABASE_URL=

# mock = desarrollo local sin Transbank
# webpay = Webpay Plus (Transbank)
PAYMENT_PROVIDER=webpay

# integration = credenciales públicas de prueba
# production = código comercio + API Key reales (solo en Netlify/.env local, nunca en git)
TRANSBANK_ENV=integration
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DEDCF3031822143F866E

# Producción (ejemplo — completar en Netlify UI o `netlify env:set`):
# TRANSBANK_ENV=production
# TRANSBANK_COMMERCE_CODE=tu_codigo_comercio
# TRANSBANK_API_KEY=tu_api_key_secret
# SITE_URL=https://casatrama.cl
