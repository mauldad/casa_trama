---
import Announcement from '@/components/Announcement.astro';
import CartDrawer from '@/components/CartDrawer.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import StoreDock from '@/components/StoreDock.astro';
import { organizationSchema } from '@/lib/seo';
import '@/styles/fonts.css';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site),
  noindex = false,
  schema,
} = Astro.props;

const pageTitle = title === 'Casa Trama' ? title : `${title} — Casa Trama`;
const schemas = schema ? [organizationSchema].concat(schema as never) : [organizationSchema];
const gtmId = import.meta.env.PUBLIC_GTM_ID;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eee8dc" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    {gtmId && <script is:inline define:vars={{ gtmId }}>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtm.js?id=${gtmId}`;
      document.head.appendChild(script);
    </script>}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="site-chrome">
      <Announcement />
      <Header />
    </div>
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <StoreDock />
    <CartDrawer />
    <script>
      interface StoredCartLine {
        productId: number;
        sku?: string;
        slug?: string;
        name?: string;
        price: number;
        image?: string;
        quantity: number;
      }

      const CART_KEY = 'casa-trama-cart-v1';
      const formatCLP = (value: number) =>
        new Intl.NumberFormat('es-CL', {
          style: 'currency',
          currency: 'CLP',
          maximumFractionDigits: 0,
        }).format(value);

      const drawer = () => document.querySelector('#cart-drawer');
      const panel = () => document.querySelector('.cart-drawer-panel');

      const readCart = (): StoredCartLine[] => {
        try {
          return JSON.parse(localStorage.getItem(CART_KEY) || '[]') as StoredCartLine[];
        } catch {
          return [];
        }
      };

      const writeCart = (cart: StoredCartLine[]) => {
        localStorage.setItem(CART_KEY, JSON.stringify(cart));
      };

      const updateCount = () => {
        const count = readCart().reduce((total, line) => total + Number(line.quantity || 0), 0);
        document.querySelectorAll('[data-cart-count]').forEach((el) => {
          el.textContent = String(count);
          el.toggleAttribute('data-empty', count === 0);
        });
      };

      const renderDrawer = (options: { highlight?: boolean } = {}) => {
        const cart = readCart();
        const linesEl = document.querySelector('#cart-drawer-lines');
        const emptyEl = document.querySelector('#cart-drawer-empty');
        const footerEl = document.querySelector('#cart-drawer-footer');
        const subtotalEl = document.querySelector('#cart-drawer-subtotal');
        const noteEl = document.querySelector('#cart-drawer-note');
        if (!(linesEl instanceof HTMLElement)) return;

        linesEl.innerHTML = '';
        cart.forEach((line) => {
          const article = document.createElement('article');
          article.className = 'cart-drawer-line';
          article.innerHTML = `
            <a class="cart-drawer-thumb" href="/producto/${line.slug ?? ''}/">
              ${line.image ? `<img src="${line.image}" alt="" width="96" height="120" />` : '<span class="material-placeholder tone-natural"></span>'}
            </a>
            <div class="cart-drawer-line-copy">
              <h3><a href="/producto/${line.slug ?? ''}/">${line.name ?? 'Pieza'}</a></h3>
              <p>${formatCLP(line.price)} · ${line.quantity} u.</p>
              <button type="button" data-remove-cart="${line.productId}">Quitar</button>
            </div>
            <p class="cart-drawer-line-total">${formatCLP(line.price * line.quantity)}</p>
          `;
          linesEl.appendChild(article);
        });

        const total = cart.reduce((sum, line) => sum + line.price * line.quantity, 0);
        if (subtotalEl) subtotalEl.textContent = formatCLP(total);
        emptyEl?.toggleAttribute('hidden', cart.length > 0);
        footerEl?.toggleAttribute('hidden', cart.length === 0);
        if (noteEl instanceof HTMLElement) {
          noteEl.hidden = !options.highlight;
          if (options.highlight) {
            window.setTimeout(() => {
              noteEl.hidden = true;
            }, 3200);
          }
        }
      };

      const openCart = (options: { highlight?: boolean } = {}) => {
        const root = drawer();
        if (!(root instanceof HTMLElement)) return;
        renderDrawer(options);
        root.hidden = false;
        requestAnimationFrame(() => root.classList.add('is-open'));
        document.body.classList.add('cart-open');
        const dialog = panel();
        if (dialog instanceof HTMLElement) dialog.focus();
      };

      const closeCart = () => {
        const root = drawer();
        if (!(root instanceof HTMLElement)) return;
        root.classList.remove('is-open');
        document.body.classList.remove('cart-open');
        window.setTimeout(() => {
          if (!root.classList.contains('is-open')) root.hidden = true;
        }, 420);
      };

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;

        const openTrigger = event.target.closest('[data-open-cart]');
        if (openTrigger instanceof HTMLElement) {
          event.preventDefault();
          openCart();
          return;
        }

        if (event.target.closest('[data-close-cart]')) {
          closeCart();
          return;
        }

        const remove = event.target.closest('[data-remove-cart]');
        if (remove instanceof HTMLElement) {
          const id = Number(remove.getAttribute('data-remove-cart'));
          writeCart(readCart().filter((line) => line.productId !== id));
          updateCount();
          renderDrawer();
          return;
        }

        const button = event.target.closest('[data-add-to-cart]');
        if (!(button instanceof HTMLButtonElement) || button.disabled) return;

        const line: StoredCartLine = {
          productId: Number(button.dataset.productId),
          sku: button.dataset.sku,
          slug: button.dataset.slug,
          name: button.dataset.name,
          price: Number(button.dataset.price),
          image: button.dataset.image,
          quantity: 1,
        };
        const cart = readCart();
        const existing = cart.find((item) => item.productId === line.productId);
        if (existing) existing.quantity += 1;
        else cart.push(line);
        writeCart(cart);
        updateCount();
        openCart({ highlight: true });
        window.dataLayer?.push({
          event: 'add_to_cart',
          ecommerce: {
            currency: 'CLP',
            value: line.price,
            items: [{ item_id: line.sku, item_name: line.name, price: line.price, quantity: 1 }],
          },
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeCart();
      });

      document.addEventListener('astro:page-load', updateCount);
      updateCount();
    </script>
  </body>
</html>
