---
import Announcement from '@/components/Announcement.astro';
import CartDrawer from '@/components/CartDrawer.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { organizationSchema } from '@/lib/seo';
import '@/styles/fonts.css';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  robots?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site),
  noindex = false,
  ogImage,
  ogType = 'website',
  ogTitle,
  ogDescription,
  robots,
  schema,
} = Astro.props;

const pageTitle = /casa\s*trama/i.test(title) ? title : `${title} — Casa Trama`;
const socialTitle = ogTitle
  ? /casa\s*trama/i.test(ogTitle)
    ? ogTitle
    : `${ogTitle} — Casa Trama`
  : pageTitle;
const socialDescription = ogDescription || description;
const schemas = schema ? [organizationSchema].concat(schema as never) : [organizationSchema];
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const robotsContent = noindex ? 'noindex,follow' : robots;
const absoluteOgImage = ogImage
  ? /^https?:\/\//i.test(ogImage)
    ? ogImage
    : new URL(ogImage, Astro.site).href
  : undefined;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      gtmId && (
        <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${gtmId}');`} />
      )
    }
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eee8dc" />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <title>{pageTitle}</title>
    <style is:inline>
      html.js body { background: #f4f0e7; }
      html.js .site-chrome,
      html.js main,
      html.js .site-footer {
        opacity: 0;
        transform: translate3d(0, 10px, 0);
      }
      html.js.is-ready .site-chrome,
      html.js.is-ready main,
      html.js.is-ready .site-footer {
        opacity: 1;
        transform: none;
        transition:
          opacity .72s cubic-bezier(.22, 1, .36, 1),
          transform .88s cubic-bezier(.22, 1, .36, 1);
      }
      html.js.is-ready main { transition-delay: .05s; }
      html.js.is-ready .site-footer { transition-delay: .12s; }
      html.js main img:not([data-no-soft]) {
        opacity: 0;
        filter: saturate(.92);
        transition:
          opacity .78s cubic-bezier(.22, 1, .36, 1),
          filter .9s ease;
      }
      html.js main img:not([data-no-soft]).is-shown {
        opacity: 1;
        filter: none;
      }
      @media (prefers-reduced-motion: reduce) {
        html.js .site-chrome,
        html.js main,
        html.js .site-footer,
        html.js main img:not([data-no-soft]) {
          opacity: 1 !important;
          transform: none !important;
          filter: none !important;
          transition: none !important;
        }
      }
    </style>
    <script is:inline>
      document.documentElement.classList.add('js');
      window.setTimeout(function () {
        document.documentElement.classList.add('is-ready');
        var hero = document.querySelector('[data-hero-fade]');
        if (hero) hero.classList.add('is-entered');
        document.querySelectorAll('main img').forEach(function (img) {
          img.classList.add('is-shown');
        });
      }, 1600);
    </script>
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Casa Trama" />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          ></iframe>
        </noscript>
      )
    }
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="site-chrome">
      <Announcement />
      <Header />
    </div>
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <script>
      interface StoredCartLine {
        productId: number;
        sku?: string;
        slug?: string;
        path?: string;
        name?: string;
        price: number;
        image?: string;
        quantity: number;
      }

      const CART_KEY = 'casa-trama-cart-v1';
      const formatCLP = (value: number) =>
        new Intl.NumberFormat('es-CL', {
          style: 'currency',
          currency: 'CLP',
          maximumFractionDigits: 0,
        }).format(value);

      const drawer = () => document.querySelector('#cart-drawer');
      const panel = () => document.querySelector('.cart-drawer-panel');

      const readCart = (): StoredCartLine[] => {
        try {
          return JSON.parse(localStorage.getItem(CART_KEY) || '[]') as StoredCartLine[];
        } catch {
          return [];
        }
      };

      const writeCart = (cart: StoredCartLine[]) => {
        localStorage.setItem(CART_KEY, JSON.stringify(cart));
      };

      const updateCount = () => {
        const count = readCart().reduce((total, line) => total + Number(line.quantity || 0), 0);
        document.querySelectorAll('[data-cart-count]').forEach((el) => {
          el.textContent = String(count);
          el.toggleAttribute('data-empty', count === 0);
        });
      };

      const renderDrawer = (options: { highlight?: boolean } = {}) => {
        const cart = readCart();
        const linesEl = document.querySelector('#cart-drawer-lines');
        const emptyEl = document.querySelector('#cart-drawer-empty');
        const footerEl = document.querySelector('#cart-drawer-footer');
        const subtotalEl = document.querySelector('#cart-drawer-subtotal');
        const noteEl = document.querySelector('#cart-drawer-note');
        if (!(linesEl instanceof HTMLElement)) return;

        linesEl.innerHTML = '';
        cart.forEach((line) => {
          const article = document.createElement('article');
          article.className = 'cart-drawer-line';
          article.innerHTML = `
            <a class="cart-drawer-thumb" href="${line.path || (line.slug ? `/producto/${line.slug}/` : '/tienda/')}">
              ${line.image ? `<img src="${line.image}" alt="" width="96" height="120" />` : '<span class="material-placeholder tone-natural"></span>'}
            </a>
            <div class="cart-drawer-line-copy">
              <h3><a href="${line.path || (line.slug ? `/producto/${line.slug}/` : '/tienda/')}">${line.name ?? 'Pieza'}</a></h3>
              <p>${formatCLP(line.price)} · ${line.quantity} u.</p>
              <button type="button" data-remove-cart="${line.productId}">Quitar</button>
            </div>
            <p class="cart-drawer-line-total">${formatCLP(line.price * line.quantity)}</p>
          `;
          linesEl.appendChild(article);
        });

        const total = cart.reduce((sum, line) => sum + line.price * line.quantity, 0);
        if (subtotalEl) subtotalEl.textContent = formatCLP(total);
        emptyEl?.toggleAttribute('hidden', cart.length > 0);
        footerEl?.toggleAttribute('hidden', cart.length === 0);
        if (noteEl instanceof HTMLElement) {
          noteEl.hidden = !options.highlight;
          if (options.highlight) {
            window.setTimeout(() => {
              noteEl.hidden = true;
            }, 3200);
          }
        }
      };

      const openCart = (options: { highlight?: boolean } = {}) => {
        const root = drawer();
        if (!(root instanceof HTMLElement)) return;
        renderDrawer(options);
        root.hidden = false;
        requestAnimationFrame(() => {
          requestAnimationFrame(() => root.classList.add('is-open'));
        });
        document.body.classList.add('cart-open');
        const dialog = panel();
        if (dialog instanceof HTMLElement) dialog.focus({ preventScroll: true });
      };

      const closeCart = () => {
        const root = drawer();
        if (!(root instanceof HTMLElement)) return;
        if (!root.classList.contains('is-open') && root.hidden) return;
        root.classList.remove('is-open');
        document.body.classList.remove('cart-open');
        window.setTimeout(() => {
          if (!root.classList.contains('is-open')) root.hidden = true;
        }, 620);
      };

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;

        const openTrigger = event.target.closest('[data-open-cart]');
        if (openTrigger instanceof HTMLElement) {
          event.preventDefault();
          openCart();
          return;
        }

        if (event.target.closest('[data-close-cart]')) {
          closeCart();
          return;
        }

        const remove = event.target.closest('[data-remove-cart]');
        if (remove instanceof HTMLElement) {
          const id = Number(remove.getAttribute('data-remove-cart'));
          writeCart(readCart().filter((line) => line.productId !== id));
          updateCount();
          renderDrawer();
          return;
        }

        const button = event.target.closest('[data-add-to-cart]');
        if (!(button instanceof HTMLButtonElement) || button.disabled) return;

        const line: StoredCartLine = {
          productId: Number(button.dataset.productId),
          sku: button.dataset.sku,
          slug: button.dataset.slug,
          path: button.dataset.path,
          name: button.dataset.name,
          price: Number(button.dataset.price),
          image: button.dataset.image,
          quantity: 1,
        };
        const cart = readCart();
        const existing = cart.find((item) => item.productId === line.productId);
        if (existing) existing.quantity += 1;
        else cart.push(line);
        writeCart(cart);
        updateCount();
        openCart({ highlight: true });
        window.dataLayer?.push({
          event: 'add_to_cart',
          ecommerce: {
            currency: 'CLP',
            value: line.price,
            items: [{ item_id: line.sku, item_name: line.name, price: line.price, quantity: 1 }],
          },
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeCart();
      });

      document.addEventListener('astro:page-load', updateCount);
      updateCount();
    </script>
    <script>
      const root = document.documentElement;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const markReady = () => {
        root.classList.add('is-ready');
      };

      if (reduce) {
        markReady();
        document.querySelectorAll('main img').forEach((img) => img.classList.add('is-shown'));
      } else {
        requestAnimationFrame(() => {
          requestAnimationFrame(markReady);
        });

        const revealImage = (img: HTMLImageElement) => {
          if (img.hasAttribute('data-no-soft')) return;
          const show = () => {
            img.classList.add('is-shown');
          };
          if (img.complete && img.naturalWidth > 0) {
            // Micro-delay so cached images still feel soft, not abrupt.
            window.setTimeout(show, 40);
            return;
          }
          img.addEventListener('load', show, { once: true });
          img.addEventListener('error', show, { once: true });
        };

        document.querySelectorAll<HTMLImageElement>('main img').forEach(revealImage);

        const hero = document.querySelector<HTMLElement>('[data-hero-fade]');
        if (hero) {
          const panels = Array.from(hero.querySelectorAll<HTMLImageElement>('.hero-panel img'));
          Promise.all(
            panels.map((img) => {
              if (img.complete && img.naturalWidth > 0) return Promise.resolve();
              return img.decode?.().catch(() => undefined) ??
                new Promise<void>((resolve) => {
                  img.addEventListener('load', () => resolve(), { once: true });
                  img.addEventListener('error', () => resolve(), { once: true });
                });
            }),
          ).then(() => {
            hero.classList.add('is-entered');
          });
          // Fallback if decode stalls
          window.setTimeout(() => hero.classList.add('is-entered'), 900);
        }
      }
    </script>
  </body>
</html>
