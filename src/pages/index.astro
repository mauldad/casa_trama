---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FiberCard from '@/components/FiberCard.astro';
import ProductCard from '@/components/ProductCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
import QrCode from '@/components/QrCode.astro';
import { getProducts } from '@/lib/commerce';
import { getLatestPost } from '@/lib/wordpress';
import { websiteSchema } from '@/lib/seo';

const products = await getProducts({ featured: true });
const latestStory = await getLatestPost();
const pieceStoryUrl = new URL('/pieza/', Astro.site).href;

const marqueePhrases = [
  'El tacto antes que la forma',
  'Calor suave sobre la piel',
  'Fibras que respiran',
  'Luz lenta de la mañana',
  'Caída silenciosa',
  'Materia que se recuerda',
  'Aire frío, tejido cálido',
  'Permanencia con suavidad',
  'Desde el sur, sin prisa',
  'Textura que acompaña',
];
---

<BaseLayout
  title="Curatoría de Ropa de Fibras Naturales en Chile| Casa Trama"
  description="Descubre nuestra selección de ropa de fibras naturales. Curamos piezas en baby alpaca, algodón pima y materiales nobles que combinan calidad y durabilidad."
  schema={websiteSchema}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hero-alpaca.webp" fetchpriority="high" type="image/webp" />
    <link rel="preload" as="image" href="/images/hero-algodon.webp" type="image/webp" />
  </Fragment>
  <section class="home-hero" aria-label="Curatoría de fibras" data-hero-fade>
    <a class="hero-panel is-active" href="/alpaca/">
      <img
        src="/images/hero-alpaca.webp"
        alt="Textil de alpaca drapeado sobre una rama frente a un lago del sur"
        width="1200"
        height="1600"
        fetchpriority="high"
        decoding="async"
        data-no-soft
      />
      <p class="hero-kicker">Exterior / 01</p>
      <div class="hero-panel-copy">
        <h2>Alpaca</h2>
        <p>Abrigo ligero para habitar el paisaje</p>
        <span class="hero-explore">Explorar <Icon name="arrow-ne" size={12} /></span>
      </div>
    </a>
    <a class="hero-panel" href="/tienda/">
      <img
        src="/images/hero-algodon.webp"
        alt="Textil de algodón sobre una silla de madera en un interior silencioso"
        width="1200"
        height="1600"
        decoding="async"
        fetchpriority="low"
        data-no-soft
      />
      <p class="hero-kicker">Tejido / 02</p>
      <div class="hero-panel-copy">
        <h2>Algodón</h2>
        <p>Frescura silenciosa. Suavidad cotidiana.</p>
        <span class="hero-explore">Explorar <Icon name="arrow-ne" size={12} /></span>
      </div>
    </a>
    <a class="hero-panel" href="/nosotras/">
      <img
        src="/images/hero-materia.webp"
        alt="Detalle de textura de fibra noble en tejido natural"
        width="819"
        height="1024"
        decoding="async"
        fetchpriority="low"
        data-no-soft
      />
      <p class="hero-kicker">Textura / 03</p>
      <div class="hero-panel-copy">
        <h2>Materia</h2>
        <p>La belleza empieza en lo que se siente.</p>
        <span class="hero-explore">Conocer <Icon name="arrow-ne" size={12} /></span>
      </div>
    </a>
  </section>

  <section class="home-intro shell" aria-labelledby="home-intro-title">
    <p class="home-intro-credit">Casa Trama / Chile</p>
    <h1 id="home-intro-title">
      Curatoría o tienda de ropa en fibras naturales y materiales nobles
    </h1>
    <p class="home-intro-lede">
      En Casa Trama nos dedicamos a buscar, seleccionar y poner a tu alcance prendas esenciales
      confeccionadas con materias primas de la más alta calidad. Desde la calidez y liviandad del
      baby alpaca hasta la suave resistencia del algodón pima, nuestra colección reúne una cuidada
      variedad de piezas diseñadas para acompañarte a lo largo del tiempo.
    </p>
    <a class="home-intro-link" href="/nosotras/">Conocer nuestra mirada /</a>
  </section>

  <section class="home-finds" aria-labelledby="home-finds-title">
    <div class="home-finds-head">
      <div>
        <p class="home-finds-kicker">Hallazgos / Baby alpaca</p>
        <h2 id="home-finds-title">Una forma más suave<br />de abrigarse.</h2>
      </div>
      <p class="home-finds-note">
        Piezas seleccionadas por su tacto, caída y composición.<br />
        Cada hallazgo está disponible en cantidades limitadas.
      </p>
    </div>
    <div class="home-finds-media">
      <figure class="home-finds-shot">
        <a class="home-finds-shot-link" href="/tienda/">
          <img
            src="/images/hallazgo-alpaca-01.webp"
            alt="Estola Trama en café mineral, sobre paisaje de bosque"
            width="1200"
            height="1600"
          />
        </a>
        <figcaption class="home-finds-caption">
          <p class="home-finds-tone">Café mineral</p>
          <h3><a href="/tienda/">Estola Trama</a></h3>
          <p class="home-finds-price">$89.000</p>
        </figcaption>
      </figure>
      <figure class="home-finds-shot">
        <a class="home-finds-shot-link" href="/alpaca/estola-luz-de-ocre/">
          <img
            src="/images/hallazgo-alpaca-02.webp"
            alt="Estola Luz de Ocre en camel mostaza, sobre paisaje de bosque"
            width="1200"
            height="1600"
          />
        </a>
        <figcaption class="home-finds-caption">
          <p class="home-finds-tone">Camel mostaza</p>
          <h3><a href="/alpaca/estola-luz-de-ocre/">Estola Luz de Ocre</a></h3>
          <p class="home-finds-price">$79.000</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="home-gaze" aria-labelledby="home-gaze-title">
    <div class="home-gaze-media">
      <img
        src="/images/hero-algodon.webp"
        alt="Estola de algodón sobre una silla de madera, con luz de tarde"
        width="1200"
        height="1600"
      />
    </div>
    <div class="home-gaze-copy">
      <p class="home-gaze-kicker">La mirada Casa Trama</p>
      <h2 id="home-gaze-title">Pequeños rituales<br />de materia.</h2>
      <p>
        Una estola sobre los hombros antes de salir. Algodón fresco cuando la tarde se vuelve lenta.
        Elegimos piezas que hacen de lo cotidiano una experiencia íntima, delicada y duradera.
      </p>
      <a class="home-gaze-link" href="/nosotras/">Descubrir nuestra curaduría /</a>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <div class="marquee-group">
            {
              [...marqueePhrases, ...marqueePhrases].map((phrase) => (
                <>
                  <span>{phrase}</span>
                  <span class="marquee-dot"></span>
                </>
              ))
            }
          </div>
        ))
      }
    </div>
  </div>

  <SectionHeading
    eyebrow="Selección de temporada"
    title="Piezas que hablan sin levantar la voz."
    link={{ href: '/tienda/', label: 'Ver todas' }}
  />
  <section class="product-grid" aria-label="Productos destacados">
    {products.map((product, index) => <ProductCard product={product} index={index} priority={index === 0} />)}
  </section>

  <section class="manifesto">
    <div class="shell manifesto-grid">
      <div class="manifesto-index">
        <p class="eyebrow">La materia importa</p>
        <span>02</span>
      </div>
      <div class="manifesto-copy">
        <h2>No elegimos una pieza solo por cómo se ve. La elegimos por <em>cómo se siente.</em></h2>
        <div class="manifesto-list">
          <article>
            <span>01</span><h3>Fibra</h3><p>Composición clara, tacto reconocible y materiales que envejecen con dignidad.</p>
          </article>
          <article>
            <span>02</span><h3>Caída</h3><p>Movimiento natural, poco peso y una forma que acompaña sin imponerse.</p>
          </article>
          <article>
            <span>03</span><h3>Tiempo</h3><p>Una relación más larga con menos piezas, mejor elegidas y bien cuidadas.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="nobility-index" aria-labelledby="nobility-title">
    <div class="shell nobility-index-inner">
      <div class="nobility-pillars" role="list">
        <article class="nobility-pillar nobility-pillar--mist" role="listitem">
          <p>01 / Tacto</p>
          <span class="nobility-pillar-icon" aria-hidden="true"><Icon name="touch" size={22} /></span>
          <h3>Suave, ligero, sereno.</h3>
        </article>
        <article class="nobility-pillar nobility-pillar--clay" role="listitem">
          <p>02 / Origen</p>
          <span class="nobility-pillar-icon" aria-hidden="true"><Icon name="leaf" size={22} /></span>
          <h3>Fibras nobles. Belleza natural.</h3>
        </article>
        <article class="nobility-pillar nobility-pillar--ink" role="listitem">
          <p>03 / Tiempo</p>
          <span class="nobility-pillar-icon" aria-hidden="true"><Icon name="time" size={22} /></span>
          <h3>Elegido para permanecer.</h3>
        </article>
      </div>

      <div class="nobility-board">
        <div class="nobility-intro">
          <p class="nobility-intro-kicker">Índice de nobleza / 01</p>
          <span class="nobility-pillar-icon" aria-hidden="true"><Icon name="guide" size={22} /></span>
          <h2 id="nobility-title">Conocer la fibra cambia la elección.</h2>
          <p>
            Una guía propia para entender qué ofrece cada material en la vida real: cómo abriga, cómo
            respira y cómo envejece.
          </p>
          <a class="nobility-cta" href="/guias/fibras-nobles/">
            Explorar todos los materiales <Icon name="arrow-ne" size={12} />
          </a>
        </div>

        <FiberCard
          index="01"
          name="Alpaca"
          summary="Resistencia, ligereza y calidez de origen andino."
          tone="ember"
          icon="alpaca"
          href="/alpaca/"
          traits={[
            { label: 'Suavidad', value: 'Alta' },
            { label: 'Calidez', value: 'Alta' },
            { label: 'Ligereza', value: 'Muy alta' },
            { label: 'Ideal para', value: 'Invierno · Viaje' },
          ]}
        />

        <FiberCard
          index="02"
          name="Algodón"
          summary="Frescura, suavidad cotidiana y una caída natural."
          tone="cream"
          icon="touch"
          href="/algodon/"
          traits={[
            { label: 'Suavidad', value: 'Alta' },
            { label: 'Frescura', value: 'Muy alta' },
            { label: 'Cuidado', value: 'Fácil' },
            { label: 'Ideal para', value: 'Diario · Verano' },
          ]}
        />
      </div>
    </div>
  </section>

  <section class="editorial-story">
    <div class="shell story-grid">
      <div class="story-collage">
        <img
          src={latestStory?.image?.src || '/images/bufanda-azul-niebla.webp'}
          alt={latestStory?.image?.alt || 'Bufanda azul niebla sobre una silla de madera'}
          width="1120"
          height="1400"
          loading="lazy"
        />
        <img src="/images/bufanda-camel.webp" alt="Detalle de bufanda camel sobre lino crudo" width="1120" height="1400" loading="lazy" />
      </div>
      <div class="story-copy">
        <p class="eyebrow">Casa Trama · Cuaderno {latestStory?.index || '01'}</p>
        <h2>{latestStory?.title || 'El frío también puede ser una forma de calma.'}</h2>
        <p class="lede">{latestStory?.excerpt || 'Cuando la mañana es lenta, la textura deja de ser adorno y se vuelve refugio.'}</p>
        <p>Desde Puerto Varas observamos la luz, el bosque y las capas con que habitamos el sur. Esa experiencia guía nuestra selección de tonos, fibras y formas.</p>
        <a class="text-link" href={latestStory ? `/historias/${latestStory.slug}/` : '/historias/'}>
          Leer {latestStory ? 'esta historia' : 'nuestras historias'} <Icon name="arrow-ne" size={11} />
        </a>
      </div>
    </div>
  </section>

  <section class="assurance">
    <div class="shell assurance-grid">
      <article><span>01</span><h3>Composición clara</h3><p>Sabes qué fibra estás llevando y cómo cuidarla.</p></article>
      <article><span>02</span><h3>Despacho en Chile</h3><p>Información de costos y plazos antes de pagar.</p></article>
      <article><span>03</span><h3>Compra acompañada</h3><p>Estamos disponibles si necesitas elegir con calma.</p></article>
    </div>
  </section>

  <section class="limited-note" aria-labelledby="limited-note-title">
    <div class="limited-note-field" aria-hidden="true">
      <span class="limited-note-glow"></span>
      <span class="limited-note-weave"></span>
      <span class="limited-note-grain"></span>
    </div>

    <div class="shell limited-note-layout">
      <article class="limited-note-card">
        <p class="limited-note-kicker">Una nota sobre nuestros hallazgos</p>
        <h2 id="limited-note-title">Stock limitado.<br />Piezas únicas.</h2>
        <p>
          Seleccionamos piezas especiales en series muy pequeñas y, en algunos casos, una única unidad.
          Cuando una pieza encuentra a su persona, puede no volver.
        </p>
        <p class="limited-note-sign">Casa Trama</p>
        <a class="limited-note-qr" href="/pieza/" aria-label="Escanear para seguir la historia de una pieza">
          <QrCode value={pieceStoryUrl} size={78} label="QR hacia la historia de la pieza" />
        </a>
        <a class="limited-note-cta" href="/tienda/">Volver a las piezas <Icon name="arrow-right" size={12} /></a>
      </article>

      <div class="limited-note-display">
        <p class="limited-note-display-copy">
          <span>Edición</span>
          <em>limitada</em>
        </p>
        <p class="limited-note-meta">Encontrado una vez. Elegido para permanecer.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero-fade]');
  if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const mobile = window.matchMedia('(max-width: 900px)');
    const items = () => Array.from(hero.querySelectorAll<HTMLElement>('.hero-panel'));
    let timer: ReturnType<typeof setInterval> | undefined;
    let resumeTimer: ReturnType<typeof setTimeout> | undefined;
    let index = Math.max(0, items().findIndex((panel) => panel.classList.contains('is-active')));
    let touchX = 0;
    let locked = false;

    const goTo = (next: number) => {
      const panels = items();
      if (!panels.length || locked) return;
      const target = ((next % panels.length) + panels.length) % panels.length;
      if (target === index && panels[target]?.classList.contains('is-active')) return;

      locked = true;
      panels.forEach((panel, i) => {
        panel.classList.toggle('is-active', i === target);
      });
      index = target;
      window.setTimeout(() => {
        locked = false;
      }, 1600);
    };

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (!mobile.matches) return;
      timer = setInterval(() => goTo(index + 1), 7400);
    };

    const pause = () => {
      stop();
      if (resumeTimer) clearTimeout(resumeTimer);
      resumeTimer = setTimeout(start, 11000);
    };

    hero.addEventListener(
      'touchstart',
      (event) => {
        touchX = event.changedTouches[0]?.clientX ?? 0;
        pause();
      },
      { passive: true },
    );

    hero.addEventListener(
      'touchend',
      (event) => {
        if (!mobile.matches) return;
        const endX = event.changedTouches[0]?.clientX ?? touchX;
        const delta = endX - touchX;
        if (Math.abs(delta) < 48) return;
        goTo(index + (delta < 0 ? 1 : -1));
        pause();
      },
      { passive: true },
    );

    mobile.addEventListener('change', () => {
      stop();
      items().forEach((panel, i) => panel.classList.toggle('is-active', i === 0 || (mobile.matches && i === index)));
      if (!mobile.matches) {
        items().forEach((panel) => panel.classList.remove('is-active'));
        return;
      }
      goTo(index);
      start();
    });

    if (mobile.matches) {
      goTo(index || 0);
      window.setTimeout(start, 4200);
    }
  }
</script>
