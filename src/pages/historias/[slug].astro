---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Trail from '@/components/Trail.astro';
import { getRankMathSeo, wpPostPermalink } from '@/lib/rankmath';
import { getPost, getPosts } from '@/lib/wordpress';

const { slug } = Astro.params;
const story = slug ? await getPost(slug) : undefined;
if (!story) return Astro.redirect('/404');

const siblings = await getPosts();
const canonical = new URL(`/historias/${story.slug}/`, Astro.site).href;
const published = new Date(story.date).toLocaleDateString('es-CL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const wpUrl = story.link || wpPostPermalink(story.slug);
const wpPath = new URL(wpUrl).pathname;
const rankMath = await getRankMathSeo({
  wpUrl,
  storefrontCanonical: canonical,
  wpPath,
});

const pageTitle = rankMath.title || story.title;
const pageDescription = rankMath.description || story.excerpt;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description: pageDescription,
  datePublished: story.date,
  mainEntityOfPage: canonical,
  image: story.image?.src ? [story.image.src] : undefined,
  author: { '@type': 'Organization', name: 'Casa Trama' },
  publisher: { '@type': 'Organization', name: 'Casa Trama', url: 'https://casatrama.cl' },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  ogTitle={rankMath.ogTitle || pageTitle}
  ogDescription={rankMath.ogDescription || pageDescription}
  ogImage={rankMath.ogImage || story.image?.src}
  ogImageWidth={rankMath.ogImageWidth || 1400}
  ogImageHeight={rankMath.ogImageHeight || 900}
  ogImageAlt={rankMath.ogImageAlt || story.image?.alt || story.title}
  ogType={rankMath.ogType || 'article'}
  robots={rankMath.robots}
  schema={[
    articleSchema,
    ...rankMath.schemas.filter((node) => {
      const type = node['@type'];
      const types = Array.isArray(type) ? type.map(String) : [String(type)];
      return !types.includes('Article') && !types.includes('BlogPosting');
    }),
  ]}
>
  <Trail
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Historias', href: '/historias/' },
      { label: story.title },
    ]}
  />
  <article class="story-page shell">
    <header class="story-page-header">
      <p class="eyebrow">Cuaderno · {story.index}</p>
      <h1>{story.title}</h1>
      <p class="story-page-meta">{published}</p>
    </header>
    {story.image && (
      <figure class="story-page-hero">
        <img src={story.image.src} alt={story.image.alt || story.title} width="1400" height="900" />
      </figure>
    )}
    <div class="prose story-prose" set:html={story.content} />
    <footer class="story-page-footer">
      <a class="text-link" href="/historias/">Volver a historias</a>
      {
        siblings.filter((item) => item.slug !== story.slug).slice(0, 2).map((item) => (
          <a class="story-next" href={`/historias/${item.slug}/`}>
            <span>{item.index}</span>
            <strong>{item.title}</strong>
          </a>
        ))
      }
    </footer>
  </article>
</BaseLayout>
