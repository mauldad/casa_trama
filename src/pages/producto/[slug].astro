---
import { getProduct } from '@/lib/commerce';
import { getProductPath } from '@/lib/product-path';

const { slug } = Astro.params;
const product = slug ? await getProduct(slug) : undefined;

if (product) {
  return Astro.redirect(getProductPath(product), 301);
}

return Astro.redirect('/tienda/', 301);
---
