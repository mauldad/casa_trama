---
import CheckoutLayout from '@/layouts/CheckoutLayout.astro';
import Icon from '@/components/Icon.astro';
import { getPublicPaymentConfig } from '@/lib/payment';

const payment = getPublicPaymentConfig();

const regions = [
  'Arica y Parinacota',
  'Tarapacá',
  'Antofagasta',
  'Atacama',
  'Coquimbo',
  'Valparaíso',
  'Metropolitana',
  "O'Higgins",
  'Maule',
  'Ñuble',
  'Biobío',
  'La Araucanía',
  'Los Ríos',
  'Los Lagos',
  'Aysén',
  'Magallanes',
];
---

<CheckoutLayout title="Checkout" description="Completa tu pedido Casa Trama con pago seguro Webpay.">
  <div class="xo">
    <div class="xo-main" id="checkout-main">
      <header class="xo-brand">
        <a class="xo-logo" href="/">CASA TRAMA</a>
        <nav class="xo-steps" aria-label="Progreso del checkout">
          <a href="/carro/">Carro</a>
          <span aria-hidden="true">/</span>
          <span aria-current="step">Información</span>
          <span aria-hidden="true">/</span>
          <span>Pago</span>
        </nav>
      </header>

      <form class="xo-form" id="checkout-form" novalidate>
        <section class="xo-section">
          <div class="xo-section-head">
            <h2>Contacto</h2>
            <a class="xo-quiet-link" href="/carro/">Volver al carro</a>
          </div>
          <div class="xo-field">
            <label for="email">Correo electrónico</label>
            <input id="email" name="email" type="email" autocomplete="email" placeholder="tu@correo.cl" required />
          </div>
          <label class="xo-check">
            <input type="checkbox" name="newsletter" value="1" />
            <span>Recibir novedades de fibras y nuevas piezas</span>
          </label>
        </section>

        <section class="xo-section">
          <div class="xo-section-head">
            <h2>Entrega</h2>
          </div>
          <div class="xo-field-grid">
            <div class="xo-field">
              <label for="first-name">Nombre</label>
              <input id="first-name" name="firstName" autocomplete="given-name" required />
            </div>
            <div class="xo-field">
              <label for="last-name">Apellido</label>
              <input id="last-name" name="lastName" autocomplete="family-name" required />
            </div>
            <div class="xo-field xo-field-full">
              <label for="address">Dirección</label>
              <input id="address" name="address" autocomplete="street-address" placeholder="Calle, número, depto" required />
            </div>
            <div class="xo-field xo-field-full">
              <label for="address2">Depto, casa, oficina <em>(opcional)</em></label>
              <input id="address2" name="address2" autocomplete="address-line2" />
            </div>
            <div class="xo-field">
              <label for="city">Comuna</label>
              <input id="city" name="city" autocomplete="address-level2" required />
            </div>
            <div class="xo-field">
              <label for="region">Región</label>
              <select id="region" name="region" required>
                <option value="">Selecciona</option>
                {regions.map((region) => <option value={region}>{region}</option>)}
              </select>
            </div>
            <div class="xo-field xo-field-full">
              <label for="phone">Teléfono</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="+56 9 ..." required />
            </div>
          </div>
        </section>

        <section class="xo-section">
          <div class="xo-section-head">
            <h2>Método de envío</h2>
          </div>
          <div class="xo-choice-list" role="radiogroup" aria-label="Método de envío">
            <label class="xo-choice is-selected">
              <input type="radio" name="shippingMethod" value="standard" checked />
              <span class="xo-choice-copy">
                <strong>Envío estándar Chile</strong>
                <small>Se confirmará plazo al activar despacho</small>
              </span>
              <span class="xo-choice-price">Por calcular</span>
            </label>
            <label class="xo-choice">
              <input type="radio" name="shippingMethod" value="pickup" disabled />
              <span class="xo-choice-copy">
                <strong>Retiro en punto</strong>
                <small>Próximamente</small>
              </span>
              <span class="xo-choice-price">—</span>
            </label>
          </div>
        </section>

        <section class="xo-section">
          <div class="xo-section-head">
            <h2>Pago</h2>
          </div>
          <div class="xo-payment-card" aria-live="polite">
            <div class="xo-payment-brand">
              <strong>{payment.label}</strong>
              <span>Pago seguro con Transbank</span>
            </div>
            <p>
              Al continuar serás redirigida a Webpay para autorizar el cobro. Casa Trama no almacena datos de tarjeta.
            </p>
            <ul class="xo-trust">
              <li>Conexión cifrada</li>
              <li>Confirmación por correo</li>
              <li>Compra protegida</li>
            </ul>
          </div>
        </section>

        <div class="xo-actions">
          <a class="xo-back" href="/carro/"><Icon name="arrow-right" size={14} class="xo-back-icon" /> Volver al carro</a>
          <button class="xo-submit" type="submit" id="checkout-submit">
            Pagar ahora <Icon name="arrow-right" size={14} />
          </button>
        </div>
        <p class="xo-error" id="checkout-error" hidden role="alert"></p>
        <p class="xo-fineprint">
          Al continuar aceptas los <a href="/terminos/">términos</a> y la <a href="/privacidad/">privacidad</a> de Casa Trama.
          Por ahora solo se cobra el total de productos; el despacho se confirma antes del go-live comercial.
        </p>
      </form>
    </div>

    <aside class="xo-summary" aria-label="Resumen del pedido">
      <div class="xo-summary-inner">
        <button class="xo-summary-toggle" type="button" id="summary-toggle" aria-expanded="false">
          <span>Mostrar resumen del pedido</span>
          <strong id="checkout-total-mobile">$0</strong>
        </button>

        <div class="xo-summary-panel" id="summary-panel">
          <div class="xo-lines" id="checkout-lines"></div>

          <div class="xo-discount">
            <label class="sr-only" for="discount">Código de descuento</label>
            <input id="discount" name="discount" type="text" placeholder="Código de descuento" disabled />
            <button type="button" disabled>Aplicar</button>
          </div>

          <div class="xo-totals">
            <div class="xo-total-row"><span>Subtotal</span><span id="checkout-subtotal">$0</span></div>
            <div class="xo-total-row"><span>Envío</span><span>Por calcular</span></div>
            <div class="xo-total-row xo-total-final"><span>Total</span><strong id="checkout-total">$0</strong></div>
            <p class="xo-currency">CLP · IVA incluido según corresponde</p>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <script is:inline define:vars={{ paymentProvider: payment.provider }}>
    const cart = JSON.parse(localStorage.getItem('casa-trama-cart-v1') || '[]');
    const formatter = new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 });
    const container = document.querySelector('#checkout-lines');
    const submitButton = document.querySelector('#checkout-submit');
    const errorElement = document.querySelector('#checkout-error');
    const summaryToggle = document.querySelector('#summary-toggle');
    const summaryPanel = document.querySelector('#summary-panel');

    if (!cart.length) {
      window.location.replace('/carro/');
    }

    cart.forEach((line) => {
      const row = document.createElement('article');
      row.className = 'xo-line';
      row.innerHTML = `
        <div class="xo-thumb">
          ${line.image ? `<img src="${line.image}" alt="" width="64" height="80" />` : ''}
          <em>${line.quantity}</em>
        </div>
        <div class="xo-line-copy">
          <strong>${line.name || 'Pieza'}</strong>
          <span>${formatter.format(line.price)} c/u</span>
        </div>
        <p class="xo-line-total">${formatter.format(line.price * line.quantity)}</p>
      `;
      container?.appendChild(row);
    });

    const total = cart.reduce((sum, line) => sum + line.price * line.quantity, 0);
    document.querySelectorAll('#checkout-total, #checkout-subtotal, #checkout-total-mobile').forEach((el) => {
      el.textContent = formatter.format(total);
    });

    summaryToggle?.addEventListener('click', () => {
      const open = summaryToggle.getAttribute('aria-expanded') === 'true';
      summaryToggle.setAttribute('aria-expanded', String(!open));
      summaryPanel?.classList.toggle('is-open', !open);
      const label = summaryToggle.querySelector('span');
      if (label) label.textContent = open ? 'Mostrar resumen del pedido' : 'Ocultar resumen del pedido';
    });

    document.querySelectorAll('.xo-choice-list input[type="radio"]').forEach((input) => {
      input.addEventListener('change', () => {
        document.querySelectorAll('.xo-choice').forEach((choice) => {
          const radio = choice.querySelector('input');
          choice.classList.toggle('is-selected', Boolean(radio?.checked));
        });
      });
    });

    function redirectToWebpay(url, token) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = url;
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'token_ws';
      input.value = token;
      form.appendChild(input);
      document.body.appendChild(form);
      form.submit();
    }

    document.querySelector('#checkout-form')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!cart.length || total <= 0) {
        if (errorElement) {
          errorElement.hidden = false;
          errorElement.textContent = 'Tu carro está vacío.';
        }
        return;
      }

      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      if (!form.reportValidity()) return;

      const formData = new FormData(form);
      submitButton?.setAttribute('disabled', 'true');
      if (submitButton) submitButton.textContent = 'Redirigiendo a Webpay…';
      if (errorElement) errorElement.hidden = true;

      window.dataLayer?.push({
        event: 'begin_checkout',
        ecommerce: { currency: 'CLP', value: total, items: cart.map((line) => ({ item_id: line.sku, quantity: line.quantity, price: line.price })) },
      });
      window.dataLayer?.push({ event: 'add_shipping_info', ecommerce: { currency: 'CLP', value: total } });
      window.dataLayer?.push({ event: 'add_payment_info', ecommerce: { currency: 'CLP', value: total, payment_type: paymentProvider } });

      try {
        const response = await fetch('/api/payments/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            amount: total,
            customerEmail: formData.get('email'),
            firstName: formData.get('firstName'),
            lastName: formData.get('lastName'),
            phone: formData.get('phone'),
          }),
        });

        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'No fue posible iniciar el pago.');

        if (payload.redirectUrl && payload.formToken) {
          redirectToWebpay(payload.redirectUrl, payload.formToken);
          return;
        }

        if (payload.redirectUrl) {
          window.location.href = payload.redirectUrl;
          return;
        }

        throw new Error('Respuesta de pago incompleta.');
      } catch (error) {
        submitButton?.removeAttribute('disabled');
        if (submitButton) {
          submitButton.innerHTML = 'Pagar ahora <svg class="icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9.25 4.5 12.75 8 9.25 11.5" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
        }
        if (errorElement) {
          errorElement.hidden = false;
          errorElement.textContent = error instanceof Error ? error.message : 'Error al iniciar el pago.';
        }
      }
    });
  </script>
</CheckoutLayout>
