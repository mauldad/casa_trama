---
import AccountLayout from '@/layouts/AccountLayout.astro';
import { formatClp, formatOrderDate, requireAccountPage } from '@/lib/account/page';
import { listCustomerOrders, orderStatusLabel } from '@/lib/account/woo-customer';

const gate = await requireAccountPage(Astro.request);
if (gate.redirect) return Astro.redirect(`${gate.redirect}?next=/cuenta/`);
const session = gate.session!;

let orders: Array<{
  id: number;
  number: string;
  statusLabel: string;
  date: string;
  total: string;
  preview: string;
}> = [];

try {
  const raw = await listCustomerOrders(session.customerId, 1, 4);
  orders = raw.map((order) => ({
    id: order.id,
    number: order.number,
    statusLabel: orderStatusLabel(order.status),
    date: order.date_created,
    total: order.total,
    preview: order.line_items?.[0]?.name || 'Pedido Casa Trama',
  }));
} catch (error) {
  console.warn('[cuenta] orders', error);
}

const greet = session.firstName || session.email.split('@')[0] || 'Hola';
---

<AccountLayout
  title="Mi trama"
  heading={`${greet}, aquí queda tu trama`}
  active="inicio"
  email={session.email}
>
  <section class="account-block" aria-labelledby="account-orders-title">
    <div class="account-block-head">
      <h2 id="account-orders-title">Últimos pedidos</h2>
      {orders.length > 0 && <a class="account-text-link" href="/cuenta/pedidos/">Ver todos</a>}
    </div>
    {orders.length === 0 ? (
      <p class="account-empty">
        Aún no hay pedidos en tu cuenta.{' '}
        <a href="/tienda/">Explorar la tienda</a>
      </p>
    ) : (
      <ul class="account-order-list">
        {orders.map((order) => (
          <li>
            <a class="account-order-row" href={`/cuenta/pedidos/${order.id}/`}>
              <div class="account-order-copy">
                <p class="account-order-title">{order.preview}</p>
                <p class="account-order-meta">
                  <span>Pedido #{order.number}</span>
                  <span>{formatOrderDate(order.date)}</span>
                  <span class="account-status">{order.statusLabel}</span>
                </p>
              </div>
              <p class="account-order-total">{formatClp(order.total)}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</AccountLayout>
