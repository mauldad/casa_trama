---
import Icon from '@/components/Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  link?: { href: string; label: string };
}
const { eyebrow, title, link } = Astro.props;
---

<header class="section-heading shell">
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {link && (
    <a class="text-link" href={link.href}
      >{link.label}<Icon name="arrow-ne" size={11} /></a
    >
  )}
</header>
