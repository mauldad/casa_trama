---
const path = Astro.url.pathname;
---

<nav class="store-dock" aria-label="Comprar">
  <a href="/tienda/" aria-current={path.startsWith('/tienda') ? 'page' : undefined}>
    <span>Tienda</span>
  </a>
  <a href="/carro/" aria-current={path.startsWith('/carro') || path.startsWith('/checkout') ? 'page' : undefined}>
    <span>Bolsa</span>
    <em data-cart-count data-empty>0</em>
  </a>
</nav>
