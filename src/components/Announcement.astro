---
import Icon from '@/components/Icon.astro';
import { getSessionFromRequest } from '@/lib/account/session';

const currentPath = Astro.url.pathname;
const accountSession = await getSessionFromRequest(Astro.request).catch(() => undefined);
const accountHref = accountSession ? '/cuenta/' : '/cuenta/entrar/';
const accountLabel = accountSession ? 'Mi trama' : 'Entrar a Mi trama';
const accountText = accountSession ? 'Mi trama' : 'Entrar';
---

<aside class="announcement" aria-label="Curaduría Casa Trama">
  <p>Curaduría de fibras nobles</p>
  <p>Materia, tacto y tiempo</p>
  <div class="announcement-end">
    <p class="announcement-shipping">Envíos a todo Chile</p>
    <a
      class="announcement-account-link"
      href={accountHref}
      aria-label={accountLabel}
      aria-current={currentPath.startsWith('/cuenta') ? 'page' : undefined}
    >
      <Icon name="user" size={12} />
      <span>{accountText}</span>
    </a>
  </div>
</aside>
