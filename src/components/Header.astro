---
import Icon from '@/components/Icon.astro';
import { getSessionFromRequest } from '@/lib/account/session';

const currentPath = Astro.url.pathname;
const accountSession = await getSessionFromRequest(Astro.request).catch(() => undefined);
const leftLinks = [
  { href: '/colecciones/', label: 'Colecciones' },
  { href: '/guias/fibras-nobles/', label: 'Materiales' },
];
const rightLinks = [{ href: '/nosotras/', label: 'Nosotras' }];
const accountHref = accountSession ? '/cuenta/' : '/cuenta/entrar/';
const mobileLinks = [
  { href: '/tienda/', label: 'Tienda' },
  ...leftLinks,
  { href: '/historias/', label: 'Historias' },
  { href: '/nosotras/', label: 'Nosotras' },
  { href: accountHref, label: accountSession ? 'Mi trama' : 'Entrar' },
  { href: '/carro/', label: 'Bolsa' },
];
---

<header class="site-header">
  <div class="header-inner">
    <button class="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false">
      <span></span><span></span>
      <span class="sr-only">Abrir menú</span>
    </button>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {leftLinks.map((link) => (
        <a href={link.href} aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>

    <a class="wordmark" href="/" aria-label="Casa Trama, inicio">CASA TRAMA</a>

    <div class="header-actions">
      {rightLinks.map((link) => (
        <a class="header-text-link" href={link.href}>{link.label}</a>
      ))}
      <button class="header-text-link" type="button" data-open-search>
        Buscar
      </button>
      <a
        class="header-text-link cart-link"
        href="/carro/"
        aria-label="Ver bolsa"
        data-open-cart
      >
        Bolsa <span data-cart-count data-empty>0</span>
      </a>
    </div>
  </div>
</header>

<div class="site-search" id="site-search" hidden>
  <button class="site-search-backdrop" type="button" data-close-search aria-label="Cerrar búsqueda"></button>
  <div
    class="site-search-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Buscar piezas"
    tabindex="-1"
  >
    <form class="site-search-form" role="search" data-search-form>
      <label class="sr-only" for="site-search-input">Buscar piezas</label>
      <Icon name="search" size={16} />
      <input
        id="site-search-input"
        name="q"
        type="search"
        placeholder="Buscar por pieza, fibra o color"
        autocomplete="off"
        enterkeyhint="search"
        data-search-input
      />
      <button class="site-search-close" type="button" data-close-search aria-label="Cerrar">
        <Icon name="close" size={16} />
      </button>
    </form>
    <p class="site-search-hint" data-search-hint>Escribe para encontrar bufandas, estolas o fibras.</p>
    <ul class="site-search-results" data-search-results hidden></ul>
    <p class="site-search-empty" data-search-empty hidden>No encontramos piezas con esa búsqueda.</p>
  </div>
</div>

<div class="mobile-menu" id="mobile-menu" hidden>
  <button class="mobile-menu-backdrop" type="button" data-close-menu aria-label="Cerrar menú"></button>
  <nav
    class="mobile-nav"
    id="mobile-nav"
    aria-label="Navegación móvil"
    tabindex="-1"
  >
    <header class="mobile-nav-head">
      <p class="mobile-nav-kicker">Casa Trama</p>
      <button class="mobile-nav-close" type="button" data-close-menu aria-label="Cerrar">
        <Icon name="close" size={18} />
      </button>
    </header>

    <div class="mobile-nav-links">
      <button type="button" style="--i: 0" data-open-search data-close-menu>
        <span>00</span>
        Buscar
      </button>
      {
        mobileLinks.map((link, index) => (
          <a
            href={link.href}
            style={`--i: ${index + 1}`}
            aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
            data-close-menu
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            {link.label}
          </a>
        ))
      }
    </div>

    <p class="mobile-nav-foot">Materia, tacto y tiempo.</p>
  </nav>
</div>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const menu = document.querySelector('#mobile-menu');
  const panel = document.querySelector('#mobile-nav');
  const label = toggle?.querySelector('.sr-only');

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement && panel instanceof HTMLElement) {
    document.body.appendChild(menu);

    let closing = false;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('menu-open', open);
      if (label) label.textContent = open ? 'Cerrar menú' : 'Abrir menú';

      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => {
          menu.classList.add('is-open');
          panel.focus({ preventScroll: true });
        });
        return;
      }

      menu.classList.remove('is-open');
      if (closing) return;
      closing = true;
      window.setTimeout(() => {
        menu.hidden = true;
        closing = false;
      }, 520);
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!open);
    });

    menu.querySelectorAll('[data-close-menu]').forEach((el) => {
      el.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  type SearchProduct = {
    id: number;
    name: string;
    eyebrow?: string;
    shortDescription?: string;
    price: number;
    path: string;
    categories?: string[];
    image?: { src: string; alt: string } | null;
  };

  const searchRoot = document.querySelector('#site-search');
  const searchPanel = searchRoot?.querySelector('.site-search-panel');
  const searchInput = document.querySelector('[data-search-input]');
  const searchResults = document.querySelector('[data-search-results]');
  const searchEmpty = document.querySelector('[data-search-empty]');
  const searchHint = document.querySelector('[data-search-hint]');
  const searchForm = document.querySelector('[data-search-form]');

  if (
    searchRoot instanceof HTMLElement &&
    searchPanel instanceof HTMLElement &&
    searchInput instanceof HTMLInputElement &&
    searchResults instanceof HTMLElement &&
    searchEmpty instanceof HTMLElement &&
    searchHint instanceof HTMLElement
  ) {
    document.body.appendChild(searchRoot);

    let catalog: SearchProduct[] | null = null;
    let closingSearch = false;
    let debounceTimer = 0;

    const formatPrice = (value: number) =>
      new Intl.NumberFormat('es-CL', {
        style: 'currency',
        currency: 'CLP',
        maximumFractionDigits: 0,
      }).format(value);

    const normalize = (value: string) =>
      value
        .normalize('NFD')
        .replace(/\p{M}/gu, '')
        .toLowerCase()
        .trim();

    const setSearchOpen = (open: boolean) => {
      document.body.classList.toggle('search-open', open);
      if (open) {
        searchRoot.hidden = false;
        requestAnimationFrame(() => {
          searchRoot.classList.add('is-open');
          searchInput.focus();
        });
        return;
      }
      searchRoot.classList.remove('is-open');
      if (closingSearch) return;
      closingSearch = true;
      window.setTimeout(() => {
        searchRoot.hidden = true;
        closingSearch = false;
      }, 280);
    };

    const loadCatalog = async () => {
      if (catalog) return catalog;
      const response = await fetch('/api/store/products');
      if (!response.ok) throw new Error('No se pudo cargar el catálogo');
      const payload = (await response.json()) as { products: SearchProduct[] };
      catalog = payload.products || [];
      return catalog;
    };

    const renderResults = (items: SearchProduct[], query: string) => {
      const hasQuery = query.length > 0;
      searchHint.hidden = hasQuery;
      searchEmpty.hidden = !hasQuery || items.length > 0;
      searchResults.hidden = !hasQuery || items.length === 0;
      searchResults.innerHTML = items
        .slice(0, 8)
        .map(
          (item) => `
            <li>
              <a href="${item.path}">
                ${
                  item.image?.src
                    ? `<img src="${item.image.src}" alt="" width="56" height="70" loading="lazy" />`
                    : '<span class="site-search-thumb" aria-hidden="true"></span>'
                }
                <span>
                  <strong>${item.name}</strong>
                  <em>${item.eyebrow || (item.categories || []).join(' · ') || 'Casa Trama'}</em>
                </span>
                <span class="site-search-price">${formatPrice(item.price)}</span>
              </a>
            </li>
          `,
        )
        .join('');
    };

    const runSearch = async (raw: string) => {
      const query = normalize(raw);
      if (!query) {
        renderResults([], '');
        return;
      }
      try {
        const products = await loadCatalog();
        const matches = products.filter((product) => {
          const haystack = normalize(
            [
              product.name,
              product.eyebrow || '',
              product.shortDescription || '',
              ...(product.categories || []),
            ].join(' '),
          );
          return query.split(/\s+/).every((token) => haystack.includes(token));
        });
        renderResults(matches, query);
      } catch {
        searchHint.hidden = true;
        searchResults.hidden = true;
        searchEmpty.hidden = false;
        searchEmpty.textContent = 'No pudimos buscar ahora. Intenta de nuevo.';
      }
    };

    document.querySelectorAll('[data-open-search]').forEach((el) => {
      el.addEventListener('click', () => {
        setSearchOpen(true);
        void loadCatalog().catch(() => undefined);
      });
    });

    searchRoot.querySelectorAll('[data-close-search]').forEach((el) => {
      el.addEventListener('click', () => setSearchOpen(false));
    });

    searchInput.addEventListener('input', () => {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(() => {
        void runSearch(searchInput.value);
      }, 140);
    });

    searchForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      void runSearch(searchInput.value);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && document.body.classList.contains('search-open')) {
        setSearchOpen(false);
      }
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        setSearchOpen(true);
      }
    });
  }
</script>
