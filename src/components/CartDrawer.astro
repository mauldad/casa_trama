---
import Icon from '@/components/Icon.astro';
---

<div class="cart-drawer" id="cart-drawer" hidden>
  <button class="cart-drawer-backdrop" type="button" data-close-cart aria-label="Cerrar bolsa"></button>
  <aside
    class="cart-drawer-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cart-drawer-title"
    tabindex="-1"
  >
    <header class="cart-drawer-header">
      <div>
        <p class="eyebrow">Tu selección</p>
        <h2 id="cart-drawer-title">Bolsa <span data-cart-count data-empty>0</span></h2>
      </div>
      <button class="cart-drawer-close" type="button" data-close-cart aria-label="Cerrar">
        <Icon name="close" size={18} />
      </button>
    </header>

    <p class="cart-drawer-note" id="cart-drawer-note" hidden>Pieza agregada con calma.</p>

    <div class="cart-drawer-body">
      <div class="cart-drawer-lines" id="cart-drawer-lines"></div>
      <div class="cart-drawer-empty" id="cart-drawer-empty" hidden>
        <h3>Tu bolsa espera una textura.</h3>
        <p>Explora piezas pensadas para acompañarte durante mucho tiempo.</p>
        <a class="button-secondary" href="/tienda/" data-close-cart>Ir a la tienda</a>
      </div>
    </div>

    <footer class="cart-drawer-footer" id="cart-drawer-footer">
      <div class="summary-row">
        <span>Subtotal</span>
        <strong id="cart-drawer-subtotal">$0</strong>
      </div>
      <p class="cart-drawer-shipping">Despacho calculado al pagar</p>
      <a class="button" href="/checkout/">Continuar al pago <Icon name="arrow-right" size={14} /></a>
      <a class="text-link cart-drawer-full" href="/carro/">Ver bolsa completa <Icon name="arrow-ne" size={11} /></a>
    </footer>
  </aside>
</div>
