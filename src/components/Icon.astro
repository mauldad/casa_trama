---
interface Props {
  name: 'arrow-ne' | 'arrow-right';
  class?: string;
  size?: number;
}

const { name, class: className = 'icon', size = 14 } = Astro.props;
---

{
  name === 'arrow-ne' ? (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M4.5 11.5L11.5 4.5M11.5 4.5H6.25M11.5 4.5V9.75"
        stroke="currentColor"
        stroke-width="1.15"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  ) : (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M3 8h10M9.25 4.5 12.75 8 9.25 11.5"
        stroke="currentColor"
        stroke-width="1.15"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
