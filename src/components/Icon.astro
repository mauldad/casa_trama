---
interface Props {
  name: 'arrow-ne' | 'arrow-right' | 'close' | 'touch' | 'leaf' | 'time' | 'guide' | 'alpaca';
  class?: string;
  size?: number;
}

const { name, class: className = 'icon', size = 14 } = Astro.props;

const paths: Record<Props['name'], string[]> = {
  'arrow-ne': ['M4.5 11.5L11.5 4.5M11.5 4.5H6.25M11.5 4.5V9.75'],
  'arrow-right': ['M3 8h10M9.25 4.5 12.75 8 9.25 11.5'],
  close: ['M4 4l8 8M12 4l-8 8'],
  touch: [
    'M3.25 11.25c2.1-2.85 5.4-2.85 7.5 0',
    'M4.75 8.6c1.4-1.85 3.6-1.85 5 0',
    'M6.2 6.15c.7-.9 1.9-.9 2.6 0',
  ],
  leaf: [
    'M8 2.75C5.4 5.2 4 7.8 4 10.15c0 2.45 1.75 3.85 4 3.85s4-1.4 4-3.85C12 7.8 10.6 5.2 8 2.75Z',
    'M8 13.5V7.25',
  ],
  time: [
    'M8 2.75a5.25 5.25 0 1 1 0 10.5A5.25 5.25 0 0 1 8 2.75Z',
    'M8 5.25v3.1L10.15 10',
  ],
  guide: [
    'M8 2.75a5.25 5.25 0 1 1 0 10.5A5.25 5.25 0 0 1 8 2.75Z',
    'M8 4.35v7.3M4.35 8h7.3',
    'M8 2.75V4M8 12v1.25M2.75 8H4M12 8h1.25',
  ],
  alpaca: [
    // orejas en lanza
    'M6.7 5.15 6.1 2.4 7.55 4.55',
    'M8.2 4.85 9 2.25 9.9 4.65',
    // cabeza roma (perfil)
    'M6.85 5.3c-.45.75-.2 1.75.7 2.2.55.28 1.25.22 1.7-.25.6-.55.65-1.4.15-2',
    // cuello largo — señal de alpaca
    'M7.55 7.55c-1.2 2.25-1.85 4.55-1.5 6.7',
    'M9.15 7.4c0 2.2-.3 4.45-.55 6.55',
  ],
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {
    paths[name].map((d) => (
      <path
        d={d}
        stroke="currentColor"
        stroke-width="1.15"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    ))
  }
</svg>
