---
import { formatCLP } from '@/lib/format';
import type { Product } from '@/types/commerce';

interface Props {
  product: Product;
  priority?: boolean;
  index?: number;
}

const { product, priority = false, index = 0 } = Astro.props;
const image = product.images[0];
---

<article class="product-card" data-product-card data-category={product.categories.join(' ').toLowerCase()} data-price={product.price}>
  <a class="product-media" href={`/producto/${product.slug}/`} aria-label={`Ver ${product.name}`}>
    {image ? (
      <img src={image.src} alt={image.alt} width="880" height="1100" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />
    ) : (
      <span class={`material-placeholder tone-${product.tone}`} aria-hidden="true"></span>
    )}
    <span class="product-index">{String(index + 1).padStart(2, '0')}</span>
    {product.stockStatus === 'outofstock' && <span class="product-status">Agotado</span>}
  </a>
  <div class="product-card-body">
    <div>
      <p class="product-eyebrow">{product.eyebrow}</p>
      <h3><a href={`/producto/${product.slug}/`}>{product.name}</a></h3>
      <p>{formatCLP(product.price)}</p>
    </div>
    <button
      class="round-action"
      type="button"
      disabled={product.stockStatus === 'outofstock'}
      data-add-to-cart
      data-product-id={product.id}
      data-sku={product.sku}
      data-slug={product.slug}
      data-name={product.name}
      data-price={product.price}
      data-image={image?.src}
      aria-label={`Agregar ${product.name} al carro`}
    >+</button>
  </div>
</article>
